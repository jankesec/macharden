#!/bin/zsh
# ==============================================================================
# macharden - macOS Security Hardening & Audit Scanner
# CLI Entrypoint & Execution Engine Orchestrator
# ==============================================================================

# Ensure execution under /bin/zsh even if invoked by bash or sh
if [ -z "$ZSH_VERSION" ]; then
    exec /bin/zsh "$0" "$@"
fi

# Configuration Defaults
MACHAR_VERSION="1.4.0"
MACHAR_CATEGORY="all"
MACHAR_FORMAT="term"
MACHAR_OUTPUT=""
MACHAR_QUIET=0
MACHAR_DO_FIX=0
MACHAR_GEN_FIX=0
MACHAR_GEN_FIX_FILE=""
MACHAR_NO_COLOR=0
MACHAR_ALERT=0
MACHAR_DAEMON_CMD=""
MACHAR_DAEMON_SCHEDULE="weekly"
MACHAR_COMPLIANCE=""
MACHAR_PROFILE=""
MACHAR_NO_PROFILE=0
typeset -ga MACHAR_SKIP_CLI=()
typeset -ga MACHAR_FILTER_CLI=()
MACHAR_LANG="${MACHAR_LANG:-en}"
MACHAR_DIFF_FILE=""
MACHAR_FAIL_ON_REGRESSION=0
MACHAR_FAIL_ON_WARN=0
MACHAR_MIN_SCORE=""
MACHAR_DRY_RUN=0
MACHAR_UNDO=0

# CLI Help and Usage
show_help() {
    cat <<EOF
macharden - macOS Security Hardening & Audit Scanner (v${MACHAR_VERSION})

Usage:
  macharden [options]

Options:
  -h, --help                 Display this help message and exit
  -v, --version              Print version information and exit
  -c, --category <name>      Run specific category of audit checks
                             Categories: hardening, network, secrets, persistence, all (default: all)
  -t, --check <id>[,id...]   Target specific check IDs only (repeatable, e.g. HARD-18,HARD-20)
  -f, --format <format>      Output report format: term, markdown, json, html, sarif (default: term)
  -l, --lang <en|tr>         Output report language: en, tr (default: en)
  -o, --output <file>        Save audit report to the specified file path
  -q, --quiet                Minimal output, print only final executive summary
  --diff <file>              Compare audit results against baseline JSON report
  --fail-on-regression       Exit with code 2 if security posture regressed compared to baseline
  --fail-on-warn             Exit with code 1 if any warnings are found
  --min-score <threshold>    Exit with code 1 if Hardening Index is below threshold
  --fix                      Interactively prompt and apply remediation fixes for failed checks
  --dry-run                  Preview remediation actions without applying changes (use with --fix)
  --undo                     Undo the most recent remediation session from backup
  --generate-fix [file]      Generate automated remediation shell script without applying
  --no-color                 Disable ANSI terminal color output
  --compliance <framework>   Filter or align checks with benchmark: cis, nist, mitre
  --daemon-install [sched]   Install and load LaunchAgent plist to run macharden periodically
                             (schedules: daily, weekly, monthly, on-login; default: weekly)
  --daemon-uninstall         Unload and remove background scan LaunchAgent
  --daemon-status            Check whether background scan daemon is loaded and running
  --alert                    Dispatch macOS desktop alert if critical issues or leaks found
  --skip-test <id>[,id...]   Skip check IDs (repeatable; Lynis-style skip-test)
  --profile <file>           Load skip-test=ID lines from a profile file
  --no-profile               Do not auto-load ~/.macharden/profile or macharden.prf

Examples:
  macharden                                 # Run full audit suite with terminal output
  macharden -c hardening                    # Run only hardening category checks
  macharden -c network -f markdown -o audit.md  # Run network audit and save Markdown report
  macharden -f json -o audit.json          # Export structured JSON audit report
  macharden -f html -o audit.html          # Export interactive HTML5 security dashboard
  macharden -f sarif -o audit.sarif        # Export OASIS SARIF v2.1.0 security report
  macharden --diff baseline.json            # Compare against baseline and display security drift
  macharden --diff base.json --fail-on-regression # Fail CI pipeline (exit 2) on security regression
  macharden --min-score 85.5                # Fail if security score is below 85.5%
  macharden --fail-on-warn                  # Fail if any warning is detected
  macharden --compliance cis                # Run audit checks aligned with CIS benchmark
  macharden -q                              # Run quietly and display only executive summary
  macharden --generate-fix fix.sh           # Generate standalone remediation script
  macharden --fix                           # Interactively remediate failed security controls
  macharden --daemon-install weekly         # Schedule weekly background security audit
  macharden --daemon-status                 # Check daemon status and previous scan logs
  macharden --daemon-uninstall              # Unload and remove background daemon
  macharden --alert                         # Run audit and trigger macOS alert on critical issues
  macharden --skip-test HARD-08,NET-07      # Skip firmware and AirDrop checks
  macharden --profile ~/.macharden/profile  # Load skip-test lines from a profile

EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --*=*)
            # GNU-style --key=value: split into --key and value
            _arg="${1%%=*}"
            _val="${1#*=}"
            shift
            set -- "$_arg" "$_val" "$@"
            continue
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        -v|--version)
            echo "macharden version ${MACHAR_VERSION}"
            exit 0
            ;;
        -c|--category)
            shift
            if [[ $# -eq 0 || -z "$1" || "$1" == -* ]]; then
                echo "Error: -c/--category requires a category name (e.g. hardening, network, secrets, persistence, all)" >&2
                exit 1
            fi
            MACHAR_CATEGORY="${1:l}"
            if [[ "$MACHAR_CATEGORY" != "hardening" && "$MACHAR_CATEGORY" != "network" && "$MACHAR_CATEGORY" != "secrets" && "$MACHAR_CATEGORY" != "persistence" && "$MACHAR_CATEGORY" != "all" ]]; then
                echo "Error: Invalid category '$MACHAR_CATEGORY'. Supported categories: hardening, network, secrets, persistence, all" >&2
                exit 1
            fi
            ;;
        -f|--format)
            shift
            if [[ $# -eq 0 || -z "$1" || "$1" == -* ]]; then
                echo "Error: -f/--format requires a format type (term, markdown, json, html, sarif)" >&2
                exit 1
            fi
            MACHAR_FORMAT="${1:l}"
            if [[ "$MACHAR_FORMAT" != "term" && "$MACHAR_FORMAT" != "markdown" && "$MACHAR_FORMAT" != "json" && "$MACHAR_FORMAT" != "html" && "$MACHAR_FORMAT" != "sarif" ]]; then
                echo "Error: Invalid format '$MACHAR_FORMAT'. Supported formats: term, markdown, json, html, sarif" >&2
                exit 1
            fi
            ;;
        --diff)
            shift
            if [[ $# -eq 0 || -z "$1" || "$1" == -* ]]; then
                echo "Error: --diff requires a baseline JSON file path" >&2
                exit 1
            fi
            MACHAR_DIFF_FILE="$1"
            ;;
        --fail-on-regression)
            MACHAR_FAIL_ON_REGRESSION=1
            ;;
        -o|--output)
            shift
            if [[ $# -eq 0 || -z "$1" || "$1" == -* ]]; then
                echo "Error: -o/--output requires a target file path" >&2
                exit 1
            fi
            MACHAR_OUTPUT="$1"
            ;;
        -q|--quiet)
            MACHAR_QUIET=1
            ;;
        --no-color)
            MACHAR_NO_COLOR=1
            ;;
        --compliance)
            shift
            if [[ $# -eq 0 || -z "$1" || "$1" == -* ]]; then
                echo "Error: --compliance requires a framework name (cis, nist, mitre)" >&2
                exit 1
            fi
            MACHAR_COMPLIANCE="${1:l}"
            if [[ "$MACHAR_COMPLIANCE" != "cis" && "$MACHAR_COMPLIANCE" != "nist" && "$MACHAR_COMPLIANCE" != "mitre" && "$MACHAR_COMPLIANCE" != "all" ]]; then
                echo "Error: Invalid compliance framework '$MACHAR_COMPLIANCE'. Supported frameworks: cis, nist, mitre, all" >&2
                exit 1
            fi
            export MACHAR_COMPLIANCE
            ;;
        --fix)
            MACHAR_DO_FIX=1
            ;;
        --dry-run)
            MACHAR_DRY_RUN=1
            ;;
        --undo)
            MACHAR_UNDO=1
            ;;
        --generate-fix)
            MACHAR_GEN_FIX=1
            # Check if optional next argument is a filename
            if [[ $# -gt 1 && "$2" != -* ]]; then
                shift
                MACHAR_GEN_FIX_FILE="$1"
            fi
            ;;
        --daemon-install)
            MACHAR_DAEMON_CMD="install"
            # Check if optional next argument is a schedule
            if [[ $# -gt 1 && "$2" != -* ]]; then
                shift
                MACHAR_DAEMON_SCHEDULE="$1"
            fi
            ;;
        --daemon-uninstall)
            MACHAR_DAEMON_CMD="uninstall"
            ;;
        --daemon-status)
            MACHAR_DAEMON_CMD="status"
            ;;
        --alert)
            MACHAR_ALERT=1
            ;;
        -t|--check)
            shift
            if [[ $# -eq 0 || -z "$1" || "$1" == -* ]]; then
                echo "Error: -t/--check requires a check ID (e.g. HARD-18 or HARD-18,HARD-20)" >&2
                exit 1
            fi
            MACHAR_FILTER_CLI+=("$1")
            ;;
        --skip-test)
            shift
            if [[ $# -eq 0 || -z "$1" || "$1" == -* ]]; then
                echo "Error: --skip-test requires a check ID (e.g. HARD-08 or HARD-08,NET-07)" >&2
                exit 1
            fi
            MACHAR_SKIP_CLI+=("$1")
            ;;
        --profile)
            shift
            if [[ $# -eq 0 || -z "$1" || "$1" == -* ]]; then
                echo "Error: --profile requires a file path" >&2
                exit 1
            fi
            MACHAR_PROFILE="$1"
            ;;
        --no-profile)
            MACHAR_NO_PROFILE=1
            ;;
        -l|--lang)
            shift
            if [[ $# -eq 0 || -z "$1" || "$1" == -* ]]; then
                echo "Error: -l/--lang requires a language code (en, tr)" >&2
                exit 1
            fi
            MACHAR_LANG="${1:l}"
            if [[ "$MACHAR_LANG" != "en" && "$MACHAR_LANG" != "tr" ]]; then
                echo "Error: Invalid language '$MACHAR_LANG'. Supported languages: en, tr" >&2
                exit 1
            fi
            export MACHAR_LANG
            ;;
        *)
            echo "Error: Unknown option '$1'" >&2
            echo "Run 'macharden --help' for available options." >&2
            exit 1
            ;;
    esac
    shift
done

# Auto-detect output format from file extension if format was not explicitly set
if [[ -n "$MACHAR_OUTPUT" && "$MACHAR_FORMAT" == "term" ]]; then
    case "$MACHAR_OUTPUT" in
        *.html) MACHAR_FORMAT="html" ;;
        *.json) MACHAR_FORMAT="json" ;;
        *.md)   MACHAR_FORMAT="markdown" ;;
        *.sarif) MACHAR_FORMAT="sarif" ;;
    esac
fi

# Resolve paths
SCRIPT_PATH="${(%):-%x}" 2>/dev/null || SCRIPT_PATH="$0"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
BASE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
LIB_DIR="$BASE_DIR/lib"

# Ensure operating system is macOS (Darwin) for audit execution
if [[ "$(uname -s)" != "Darwin" && "${MACHAR_ALLOW_NON_DARWIN:-0}" -ne 1 ]]; then
    echo "Error: macharden audit scans are designed exclusively for macOS (Darwin). Current OS: $(uname -s)" >&2
    exit 1
fi

# Load Core Modules
for mod in i18n.sh ui.sh engine.sh report.sh report_html.sh remediate.sh monitor.sh compliance.sh diff.sh report_sarif.sh; do
    if [[ -f "$LIB_DIR/$mod" ]]; then
        source "$LIB_DIR/$mod"
    else
        echo "Error: Required engine module '$mod' not found in $LIB_DIR" >&2
        exit 1
    fi
done

# Initialize Localization
i18n_init "$MACHAR_LANG"

# Initialize UI styling
if (( MACHAR_NO_COLOR )); then
    ui_disable_colors
else
    ui_init_colors
fi

# Dispatch Daemon Control Commands
if [[ -n "$MACHAR_DAEMON_CMD" ]]; then
    case "$MACHAR_DAEMON_CMD" in
        install)
            daemon_install "$MACHAR_DAEMON_SCHEDULE"
            exit $?
            ;;
        uninstall)
            daemon_uninstall
            exit $?
            ;;
        status)
            daemon_status
            exit $?
            ;;
    esac
fi

# Load skip-test profile (defaults, then --profile, then CLI --skip-test)
if (( ! MACHAR_NO_PROFILE )); then
    [[ -f "$HOME/.macharden/profile" ]] && load_skip_profile "$HOME/.macharden/profile"
    [[ -f "$BASE_DIR/macharden.prf" ]] && load_skip_profile "$BASE_DIR/macharden.prf"
fi
if [[ -n "$MACHAR_PROFILE" ]]; then
    if ! load_skip_profile "$MACHAR_PROFILE"; then
        echo "Error: profile not readable: $MACHAR_PROFILE" >&2
        exit 1
    fi
fi
for _skip in "${MACHAR_SKIP_CLI[@]}"; do
    add_skip_test "$_skip"
done
for _filt in "${MACHAR_FILTER_CLI[@]}"; do
    add_filter_check "$_filt"
done

# Load all available audit modules dynamically
for audit_file in "$LIB_DIR"/audit_*.sh; do
    if [[ -f "$audit_file" ]]; then
        source "$audit_file"
    fi
done

# Display Banner for Terminal UI mode
if [[ "$MACHAR_FORMAT" == "term" && "$MACHAR_QUIET" -eq 0 ]]; then
    ui_banner
fi

# Execute Audit Checks
run_audit "$MACHAR_CATEGORY"

# Baseline Drift & Diff Evaluation
if [[ -n "$MACHAR_DIFF_FILE" ]]; then
    if ! diff_load_baseline "$MACHAR_DIFF_FILE"; then
        echo "Error: Failed to load baseline from '$MACHAR_DIFF_FILE'" >&2
        exit 1
    fi
    diff_calculate
fi

# Generate Requested Report
if [[ -n "$MACHAR_COMPLIANCE" ]]; then
    report_compliance_framework "$MACHAR_COMPLIANCE" "$MACHAR_FORMAT" "$MACHAR_OUTPUT"
else
    case "$MACHAR_FORMAT" in
        term)
            if [[ -n "$MACHAR_OUTPUT" ]]; then
                # Capture terminal report once to avoid redundant rendering
                local term_rendered
                term_rendered=$(report_terminal)
                if [[ -n "$MACHAR_DIFF_FILE" ]]; then
                    term_rendered+=$'\n'$(diff_report_terminal)
                fi
                # Strip ANSI escape codes for clean text file
                printf "%s\n" "$term_rendered" | sed -E $'s/\x1B\\[[0-9;]*[a-zA-Z]//g' > "$MACHAR_OUTPUT"
                if (( ! MACHAR_QUIET )); then
                    printf "%s\n" "$term_rendered"
                    ui_success "Audit summary saved to: ${MACHAR_OUTPUT}"
                fi
            else
                report_terminal
                if [[ -n "$MACHAR_DIFF_FILE" ]]; then
                    diff_report_terminal
                fi
            fi
            ;;
        markdown)
            report_markdown "$MACHAR_OUTPUT"
            ;;
        json)
            report_json "$MACHAR_OUTPUT"
            ;;
        html)
            report_html "$MACHAR_OUTPUT" "$MACHAR_LANG"
            ;;
        sarif)
            report_sarif "$MACHAR_OUTPUT"
            ;;
    esac
fi

# Handle Fix Generation or Interactive Remediation
if (( MACHAR_GEN_FIX )); then
    generate_remediation_script "$MACHAR_GEN_FIX_FILE"
fi

if (( MACHAR_UNDO )); then
    undo_last_remediation
    exit $?
fi

if (( MACHAR_DO_FIX )); then
    apply_remediations
fi

# Continuous Monitoring & Alerting
if (( MACHAR_ALERT )); then
    send_alert "$HARDENING_INDEX" "$COUNT_FAIL"
fi

# Fail on regression check
if (( MACHAR_FAIL_ON_REGRESSION )) && diff_has_regressions; then
    exit 2
fi

if (( COUNT_FAIL > 0 )); then
    exit 1
elif (( MACHAR_FAIL_ON_WARN )) && (( COUNT_WARN > 0 )); then
    exit 1
elif [[ -n "$MACHAR_MIN_SCORE" ]]; then
    if (( $(echo "$HARDENING_INDEX < $MACHAR_MIN_SCORE" | bc -l 2>/dev/null || echo 0) )); then
        exit 1
    fi
fi

exit 0
